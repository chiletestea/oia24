# Ver README / reporte de implementación para más contexto.

# Ya existentes
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Nuevas — fundamentos de privacidad y supervisión
ENCRYPTION_KEY=            # 32+ chars. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESEND_API_KEY=            # desde resend.com
EMAIL_FROM="openia.cl <hola@openia.cl>"   # debe ser un dominio verificado en Resend
NEXT_PUBLIC_SITE_URL=https://openia.cl    # usado para armar links en emails (forget-me, continuar programa)
SUPERVISOR_API_KEY=        # secreto que usa Luis para /api/supervisor/*
CRON_SECRET=               # protege /api/cron/resumen-diario — Vercel lo manda como "Authorization: Bearer $CRON_SECRET"
